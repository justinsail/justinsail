---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LogList from '../components/LogList.astro';
import headshot from '../assets/photos/headshot.jpg';
import maccog from '../assets/logo-maccog.png';
import { spine, whatIDo, facetsIntro, facets, logIntro, note, inline } from '../lib/readme';
import { facetPhotos, facetLogos } from '../lib/photos';
import { posts } from '../lib/log';
const recent = (await posts()).slice(0, 5);
---
<Base>
  <header class="hero">
    <div class="hero-top">
      <Image class="headshot" src={headshot} alt="Justin Bradshaw" width={320} loading="eager" />
      <div><h1>Justin Bradshaw</h1><p class="tagline">Digital Life Coach · MacCog · San Luis Obispo</p></div>
    </div>
    <p class="spine" set:html={inline(spine)} />
  </header>

  <h2>What I do now</h2>
  <p class="org"><Image src={maccog} alt="" width={80} /><a href="https://maccog.com">MacCog</a></p>
  {whatIDo.map((p) => (
    <p id={p.startsWith("I'm also available for speaking") ? 'speaking' : undefined} set:html={inline(p)} />
  ))}

  <h2 id="facets">Facets</h2>
  <p set:html={inline(facetsIntro)} />
  <div class="facets">
    {facets.map((f) => {
      const photos = facetPhotos[f.slug] ?? [];
      const logo = facetLogos[f.slug];
      return (
        <section class="facet">
          <h3>{f.name}</h3>
          <p set:html={inline(f.text)} />
          {logo && <Image class="facet-logo" src={logo.src} alt={logo.alt} width={600} />}
          {photos.length > 0 && (
            <div class={`photos n${photos.length}`}>
              {photos.map((ph, i) => (
                <Image src={ph.src} alt={ph.alt} widths={[400, 800, 1200]} sizes={i === 0 ? '(min-width: 700px) 560px, 100vw' : '(min-width: 700px) 280px, 50vw'} style={ph.pos ? `object-position:${ph.pos}` : undefined} />
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>

  <h2 id="log">The log</h2>
  <p set:html={inline(logIntro.replace('`/log`', '[The log](/log/)'))} />
  <LogList items={recent} />

  <h2>A note on this page</h2>
  {note.map((p) => <p set:html={inline(p)} />)}
</Base>

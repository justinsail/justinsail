---
import '../styles.css';
import { spine, links, profiles } from '../lib/readme';
interface Props { title?: string; description?: string; type?: 'website' | 'article' }
const { title, description = 'Justin Bradshaw: Digital Life Coach, MacCog, Apple and AI consulting in San Luis Obispo.', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · Justin Bradshaw` : 'Justin Bradshaw';
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/justin-bradshaw.jpg', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://justinbradshaw.com/#person',
  name: 'Justin Bradshaw',
  url: 'https://justinbradshaw.com/',
  image: image.href,
  jobTitle: 'Digital Life Coach',
  description: spine,
  email: 'mailto:justin@maccog.com',
  worksFor: { '@type': 'Organization', name: 'MacCog', url: 'https://maccog.com' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Northwestern University' },
  address: { '@type': 'PostalAddress', addressLocality: 'San Luis Obispo', addressRegion: 'CA', addressCountry: 'US' },
  sameAs: profiles,
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical.href}>
<link rel="icon" href="/favicon.png">
<link rel="alternate" type="application/rss+xml" title="Justin Bradshaw: the log" href="/rss.xml">
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical.href}>
<meta property="og:image" content={image.href}>
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<nav><div class="wrap"><a class="name" href="/">Justin Bradshaw</a><a href="/#facets">Facets</a><a href="/log/">Log</a><a href="/#speaking">Speaking</a><a href="https://github.com/justinsail/justinsail">GitHub</a></div></nav>
<main class="wrap" id="main"><slot /></main>
<footer><div class="wrap"><ul>{links.filter((l) => !l.href.includes('justinbradshaw.com')).map((l) => <li><a href={l.href}>{l.label === 'Email' ? l.text : l.label}</a></li>)}<li><a href="/rss.xml">RSS</a></li></ul><p class="meta">Rendered from <a href="https://github.com/justinsail/justinsail">github.com/justinsail/justinsail</a>.</p></div></footer>
</body>
</html>
